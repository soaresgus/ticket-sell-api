              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "data": [],
                  "message": "Ticket not found.",
                  "code": "TICKET_NOT_FOUND"
                }
              }
            }
          },
          "409": {
            "description": "There is not enough stock, or the user already has an open reservation for this ticket.",
