    "/tickets/{id}/buy": {
      "post": {
        "tags": ["Tickets"],
        "summary": "Reserve tickets",
        "description": "Starts a reservation for the user identified by the Bearer token. Does not create a purchase. `quantity` defaults to 1 when the body is omitted.",
        "operationId": "ticketsBuy",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ticket cuid",
            "schema": {
              "type": "string",
              "example": "clx0ticket0001abcdefghijk"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation created. Status is RESERVED.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": {
                  "success": true,
                  "data": {
                    "id": "clx0reserv0001abcdefghijk",
                    "ticketId": "clx0ticket0001abcdefghijk",
                    "userId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "quantity": 1,
                    "status": "RESERVED",
                    "createdAt": "2026-09-24T12:30:00.000Z",
                    "ticket": {
                      "id": "clx0ticket0001abcdefghijk",
                      "title": "Rock Festival 2026",
                      "description": "Main stage, general admission",
                      "price": 150,
                      "quantity": 100,
                      "createdAt": "2026-09-24T12:00:00.000Z",
                      "updatedAt": "2026-09-24T12:00:00.000Z"
                    }
                  },
                  "message": "Ticket reserved successfully.",
                  "code": "TICKET_RESERVED"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "No ticket exists with the given id.",
