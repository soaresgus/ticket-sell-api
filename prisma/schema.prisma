generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  password           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ticketPurchasers   TicketPurchaser[]
  ticketReservations TicketReservation[]

  @@map("users")
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Ticket {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  price              Float
  quantity           Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ticketPurchasers   TicketPurchaser[]
  ticketReservations TicketReservation[]

  @@map("tickets")
}

model TicketReservation {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Ticket Ticket @relation(fields: [ticketId], references: [id])
  User   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_reservations")
}

model TicketPurchaser {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Ticket Ticket @relation(fields: [ticketId], references: [id])
  User   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_purchasers")
}
